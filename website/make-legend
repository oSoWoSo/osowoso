#!/usr/bin/env bash
#
# Generate the Legend (help message) - intended to be passed to `tools/box`
#
# Author: Dave Eddy <dave@daveeddy.com>
# Date: January 30, 2026
# License: MIT
#
# Contributors: zenobit <zen@duck.com>

. ./theme || exit

UNDERLINE=$'\x1b[3m'

format-box() {
	local title=$1
	shift

	if [[ -z $1 ]]; then
		return
	fi
	local cmd_re='^(\$ [^ ]+)(.*)$'
	{
		echo '%'
		local line name url
		for line in "$@"; do
			IFS='%' read -r name url <<< "$line"

			if [[ $name =~ $cmd_re ]]; then
				local cmd=${BASH_REMATCH[1]}
				local rest=${BASH_REMATCH[2]}

				echo -n "$COLOR3$cmd$RST$COLOR5$rest"
			else
				echo -n "$COLOR5$name$RST"
			fi

			echo -n '%'
			echo -n "$COLOR1$UNDERLINE$url$RST"
			echo
		done
	} | ./tools/box -s '%' -hp 1 -tc "$COLOR5" -T plain -t "$title"
}

full='false'
while getopts 'f' opt; do
	case "$opt" in
		f) full='true';;
		*) exit 1;;
	esac
done

legend=(
	'$ curl osowoso.org%Get this page'
	'$ curl osowoso.org/episodes%Get the list of episodes in the YSAP series'
	'$ curl osowoso.org/json%Get the above in JSON format'
	'$ curl osowoso.org/help%Get the full list of available endpoints'
)
resources=()
extras=()

if $full; then
	legend+=(
		'$ curl osowoso.org/ping%Get a 200 with the text pong'
		'$ curl [-46] osowoso.org/ip%Get your current IP address as a string'
	)

	resources+=(
		'$ curl style.osowoso.org%Bash Style Guide for writing safe scripts'
	)

	extras+=(
		'$ curl xmas.osowoso.org | bash%Christmas tree animation'
		'$ curl nightfall.osowoso.org | bash%Music Album TUI'
	)
fi

format-box Legend "${legend[@]}"
format-box Resources "${resources[@]}"
format-box Extras "${extras[@]}"
