	</head>
	<body>
		<div id="container">
			<div id="top-nav">
				<ul>
				${m}
				</ul>
			</div>

			${top}
			<p class="content">
			${body}
			</p>
			${id}
${giscus}
${footer}
EOF

unset title h top body footer
